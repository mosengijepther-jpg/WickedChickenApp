<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_cream"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/welcomeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_message"
            android:textColor="@color/primary_red"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Finger Lickin' Wicked Good Fast Food!"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/viewCategoriesButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/accent_amber"
            android:text="@string/view_categories"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <Button
            android:id="@+id/viewCartButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="@color/card_background"
            android:text="@string/shopping_cart"
            android:textColor="@color/primary_red"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/primary_red"
            app:strokeWidth="2dp" />
    </LinearLayout>
</LinearLayout>
